node_modules/

# state lokal wrangler, termasuk file SQLite D1 lokal yang memuat suara uji
.wrangler/
.dev.vars

# Salt untuk hash IP. SATU-SATUNYA rahasia yang menanggung beban di sistem
# ini: tanpa salt, nilai `sidik` 16-hex yang diterbitkan ke publik lewat
# /api/riwayat bisa dibalik dengan mudah, karena ruang IPv4 cuma 2^32.
.ip-salt

# basis data lokal adapter PHP
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

screenshot/
_site/
cadangan/

# keluaran build untuk Cloudflare Pages, dibuat alat/deploy-cf.mjs.
# Konfigurasinya (pages/wrangler.toml) justru DI-COMMIT.
pages/keluaran/

# salinan lokal IP_SALT, supaya Worker dan Pages bisa memakai salt yang sama.
# Rahasia di Cloudflare hanya bisa ditulis, tidak bisa dibaca balik.
.cf-ip-salt
